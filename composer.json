{
    "name": "smstunnel/smstunnel-magento",
    "description": "SMSTunnel for Magento: order texts sent from your own Android phone, from your own number. Order placed, invoice, shipment with tracking, canceled and status texts for customers, and new-order texts for you.",
    "type": "magento2-module",
    "version": "1.0.0",
    "license": "MIT",
    "keywords": [
        "magento",
        "magento2",
        "mage-os",
        "adobe-commerce",
        "sms",
        "text message",
        "order texts",
        "shipment tracking",
        "smstunnel",
        "android"
    ],
    "homepage": "https://smstunnel.io",
    "authors": [
        {
            "name": "Narcis Bodea",
            "email": "contact@narboweb.ro",
            "homepage": "https://smstunnel.io",
            "role": "Developer"
        }
    ],
    "support": {
        "email": "contact@narboweb.ro",
        "docs": "https://smstunnel.io"
    },
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0||~8.5.0",
        "magento/framework": "~103.0.6",
        "magento/framework-message-queue": "~100.4.6",
        "magento/module-backend": "~102.0.6",
        "magento/module-config": "~101.2.6",
        "magento/module-cron": "~100.4.6",
        "magento/module-mysql-mq": "~100.4.4",
        "magento/module-sales": "~103.0.6",
        "magento/module-store": "~101.1.6",
        "magento/module-ui": "~101.2.6"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "SmsTunnel\\SmsNotifications\\": ""
        }
    },
    "archive": {
        "exclude": [
            "/dev",
            "/.gitattributes",
            "/.gitignore",
            "/PUBLISHING.md",
            "/site-page.md"
        ]
    }
}
