<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- var/log/smstunnel.log -->
    <virtualType name="SmsTunnelSmsNotificationsLogHandler" type="Magento\Framework\Logger\Handler\Base">
        <arguments>
            <argument name="fileName" xsi:type="string">/var/log/smstunnel.log</argument>
        </arguments>
    </virtualType>
    <virtualType name="SmsTunnelSmsNotificationsLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="name" xsi:type="string">smstunnel</argument>
            <argument name="handlers" xsi:type="array">
                <item name="system" xsi:type="object">SmsTunnelSmsNotificationsLogHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="SmsTunnel\SmsNotifications\Model\Outbox">
        <arguments>
            <argument name="logger" xsi:type="object">SmsTunnelSmsNotificationsLogger</argument>
        </arguments>
    </type>
    <type name="SmsTunnel\SmsNotifications\Model\Sender">
        <arguments>
            <argument name="logger" xsi:type="object">SmsTunnelSmsNotificationsLogger</argument>
        </arguments>
    </type>
    <type name="SmsTunnel\SmsNotifications\Model\Queue\Consumer">
        <arguments>
            <argument name="logger" xsi:type="object">SmsTunnelSmsNotificationsLogger</argument>
        </arguments>
    </type>
    <type name="SmsTunnel\SmsNotifications\Observer\OrderPlaced">
        <arguments>
            <argument name="logger" xsi:type="object">SmsTunnelSmsNotificationsLogger</argument>
        </arguments>
    </type>
    <type name="SmsTunnel\SmsNotifications\Observer\OrderSaved">
        <arguments>
            <argument name="logger" xsi:type="object">SmsTunnelSmsNotificationsLogger</argument>
        </arguments>
    </type>
    <type name="SmsTunnel\SmsNotifications\Observer\InvoiceSaved">
        <arguments>
            <argument name="logger" xsi:type="object">SmsTunnelSmsNotificationsLogger</argument>
        </arguments>
    </type>
    <type name="SmsTunnel\SmsNotifications\Observer\ShipmentSaved">
        <arguments>
            <argument name="logger" xsi:type="object">SmsTunnelSmsNotificationsLogger</argument>
        </arguments>
    </type>
    <type name="SmsTunnel\SmsNotifications\Cron\SendPending">
        <arguments>
            <argument name="logger" xsi:type="object">SmsTunnelSmsNotificationsLogger</argument>
        </arguments>
    </type>

    <!-- The sent-texts grid (Sales > SMSTunnel Texts). -->
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="smstunnel_message_listing_data_source" xsi:type="string">SmsTunnel\SmsNotifications\Model\ResourceModel\Message\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="SmsTunnel\SmsNotifications\Model\ResourceModel\Message\Grid\Collection"
                 type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">smstunnel_message</argument>
            <argument name="resourceModel" xsi:type="string">SmsTunnel\SmsNotifications\Model\ResourceModel\Message</argument>
        </arguments>
    </virtualType>

    <!-- Keep the API key out of app:config:dump, and the server URL in env.php only. -->
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="smstunnel/general/api_key" xsi:type="string">1</item>
            </argument>
            <argument name="environment" xsi:type="array">
                <item name="smstunnel/advanced/server_url" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
</config>
